# Template only — do not commit real credentials.
# Prefer generating the secret from .env via scripts/k8s-apply.sh:
#   kubectl -n allforone create secret generic mongo \
#     --from-literal=MONGO_URI='...' \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# Or copy this file to secret-mongo.yaml (gitignored if you create it locally),
# replace the placeholder, then: kubectl apply -f k8s/secret-mongo.yaml
apiVersion: v1
kind: Secret
metadata:
  name: mongo
  namespace: allforone
type: Opaque
stringData:
  MONGO_URI: "mongodb+srv://USER:PASS@HOST/?appName=APP"
